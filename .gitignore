# All build products, SDK installs, benchmark output and experiment data.
/build/

# xmake per-directory cache (only ever created inside build/, defensive)
.xmake/

# clangd index produced by the xmake compile_commands plugin
/.cache/

# Local assistant session state (work log). Project-level skills under
# .workbuddy/skills/ stay committable; only the scratch memory is ignored.
/.workbuddy/memory/

# Perf traces and raw benchmark logs are evidence artifacts, not sources.
*.perf
perf.data
perf.data.*
/results/
/data/

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
